{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src", "cli", "tests"]
}
